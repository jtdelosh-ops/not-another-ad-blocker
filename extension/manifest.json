{
  "manifest_version": 3,
  "name": "Not Another Ad Blocker — Local Preview",
  "version": "0.4.0",
  "description": "A local-first filtering prototype with a Rust native companion and explicit rule diagnostics.",
  "minimum_chrome_version": "121",
  "permissions": ["storage", "unlimitedStorage", "nativeMessaging", "declarativeNetRequest", "declarativeNetRequestFeedback", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Not Another Ad Blocker", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "options_page": "options.html",
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
